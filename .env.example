# Enterprise Agent Gateway — demo defaults (no real secrets)
APP_NAME=Enterprise Agent Gateway
APP_ENV=demo
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (SQLite for local demo)
DATABASE_URL=sqlite+aiosqlite:///./artifacts/agent_gateway.db

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Demo mode — synthetic data, no external LLM calls
DEMO_MODE=true

# Request tracing
REQUEST_ID_HEADER=X-Request-ID

# Health checks
READINESS_DB_CHECK=true

# Demo API keys (local-only — plaintext keys for portfolio demo)
# employee/northstar: demo-employee-northstar
# analyst/northstar:  demo-analyst-northstar
# fm/northstar:       demo-fm-northstar
# analyst/lakeshore:  demo-analyst-lakeshore
# platform admin:     demo-admin
