# Enterprise Agent Gateway — demo defaults (no real secrets)
APP_NAME=Enterprise Agent Gateway
APP_ENV=demo
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (SQLite for local demo)
DATABASE_URL=sqlite+aiosqlite:///./artifacts/agent_gateway.db

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Demo mode — synthetic data, no external LLM calls
DEMO_MODE=true

# Request tracing
REQUEST_ID_HEADER=X-Request-ID

# Health checks
READINESS_DB_CHECK=true

# Rate limiting (per authenticated tenant)
RATE_LIMIT_PER_MINUTE=120

# Provider model configuration (see config/models.example.yaml)
MODELS_CONFIG_PATH=config/models.example.yaml
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
# employee/northstar: demo-employee-northstar
# analyst/northstar:  demo-analyst-northstar
# fm/northstar:       demo-fm-northstar
# analyst/lakeshore:  demo-analyst-lakeshore
# platform admin:     demo-admin

# GitHub (optional — local git push helper; keep real values in .env only)
# GITHUB_USERNAME=your-github-username
# GITHUB_TOKEN=ghp_your_personal_access_token
